def range_sum(numbers, start, end):
    if start == end:
        return numbers[end]
    return numbers[start] + range_sum(numbers, start+1, end)


#Test1
print(range_sum([1, 2, 3, 4, 5, 6, 7, 8, 9], 3, 7)) #30
#Test2
print(range_sum([1, 2, 3, 4, 5, 6, 7, 8, 9], 0, 8)) #45
