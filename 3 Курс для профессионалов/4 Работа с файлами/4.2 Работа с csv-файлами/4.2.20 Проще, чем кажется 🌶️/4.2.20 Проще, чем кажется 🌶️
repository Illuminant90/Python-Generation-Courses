from csv import reader, writer

def condense_csv(fl_name, id_name):
    with open('C:\\Users\\Illum\\Documents\\Python\\Python-Generation-Courses\\3 Курс для профессионалов\\4.2.20 Проще, чем кажется 🌶️\\' + fl_name, encoding='utf-8') as fl_in:
        rows = reader(fl_in)
        data_dict = dict()
        for row in rows:
            object_name = row[0]
            data_dict.setdefault(object_name, dict())
            for i, object_characteristic in enumerate(row[1:], start=1):
                if int(i) % 2 == 1:
                    object_char = object_characteristic
                    data_dict[object_name][object_char] = None
                else:
                    data_dict[object_name][object_char] = object_characteristic
    with open(r'C:\Users\Illum\Documents\Python\Python-Generation-Courses\3 Курс для профессионалов\4.2.20 Проще, чем кажется 🌶️\condensed.csv', 'w', encoding='utf-8', newline='') as fl_out:
        columns = [id_name]
        for column in data_dict[object_name]:
            columns.append(column)
        wr = writer(fl_out)
        wr.writerow(columns)
        for object_name in data_dict:
            row = [object_name]
            for object_characteristic in data_dict[object_name]:
                row.append(data_dict[object_name][object_characteristic])
            wr.writerow(row)
               

