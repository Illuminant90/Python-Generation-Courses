from datetime import datetime
from zipfile import ZipFile

result = list()
with ZipFile('test.zip') as fl_zip:
    for procesed_fl in fl_zip.infolist():
        if not procesed_fl.is_dir():
            result.append((procesed_fl.filename.split('/')[-1], datetime(*procesed_fl.date_time), procesed_fl.file_size, procesed_fl.compress_size))
result.sort()            
for fl in result:
    print(fl[0])
    print(f'  Дата модификации файла: {fl[1]}')
    print(f'  Объем исходного файла: {fl[2]} байт(а)')
    print(f'  Объем сжатого файла: {fl[3]} байт(а)')
    print()