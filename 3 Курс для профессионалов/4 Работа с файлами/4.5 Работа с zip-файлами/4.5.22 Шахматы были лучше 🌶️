from json import loads
from zipfile import ZipFile

def is_correct_json(string):
    try:
        loads(string)
        return True
    except:
        return False

result = list()
with ZipFile('test.zip') as fl_zip:
    for procesed_fl in fl_zip.infolist():
        if procesed_fl.filename.endswith('.json'):
            with fl_zip.open(procesed_fl.filename) as fl_json:
                football_player = fl_json.read().decode('utf-8')
                if is_correct_json(football_player):
                    football_player = loads(football_player)
                    if football_player.get('team') == 'Arsenal':
                        result.append((football_player.get('first_name'), football_player.get('last_name')))
result.sort()
for name, surname in result:
    print(name, surname)