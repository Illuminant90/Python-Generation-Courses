from collections import Counter

def print_bar_chart(data, mark):
    max_len_line = max(map(len, data))
    for text, count in Counter(data).most_common():
        print(f'{text:{max_len_line}} |{mark * count}')


#TEST_1
print_bar_chart('beegeek', '+')
#TEST_2
languages = ['java', 'java', 'python', 'C++', 'assembler', 'java', 'C++', 'C', 'pascal', 'C++', 'pascal', 'java']

print_bar_chart(languages, '#')