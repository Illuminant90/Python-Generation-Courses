def is_good_password(password):
    if isinstance(password, str):
        criteria_1 = (len(password) >= 9) #Пароль длинее 9 символов
        criteria_2 = (password != password.upper() and password != password.lower()) #в нем присутствуют большие и маленькие буквы любого алфавита
        criteria_3 = any([str(digit) in password for digit in range(10)]) #в нем имеется хотя бы одна цифра
        return all((criteria_1, criteria_2, criteria_3))
    else:
        return False


#Test1
print(is_good_password('41157082')) # False
#Test2
print(is_good_password('мойпарольсамыйлучший')) #False
#Test3
print(is_good_password('МойПарольСамыйЛучший111')) #True